rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global helper primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'corcomunicaciones@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidMeeting(data) {
      return data.keys().hasAll([
          'roomId',
          'title',
          'organizer',
          'notes',
          'date',
          'startMinutes',
          'endMinutes',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'roomId',
          'title',
          'organizer',
          'notes',
          'date',
          'startMinutes',
          'endMinutes',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.roomId is string
        && data.roomId.size() >= 1 && data.roomId.size() <= 32
        && data.roomId in ['sala-piso-8-dap', 'sala-a-opt', 'sala-b-opt']
        && data.title is string
        && data.title.size() >= 1 && data.title.size() <= 120
        && data.organizer is string
        && data.organizer.size() <= 80
        && data.notes is string
        && data.notes.size() <= 400
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startMinutes is int
        && data.startMinutes >= 420 && data.startMinutes <= 1110
        && data.startMinutes % 30 == 0
        && data.endMinutes is int
        && data.endMinutes >= 450 && data.endMinutes <= 1140
        && data.endMinutes % 30 == 0
        && data.endMinutes > data.startMinutes
        && data.createdBy is string
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Meeting reservations: public schedule reading per valid room, admin-only mutations
    match /meetings/{meetingId} {
      allow get: if isValidId(meetingId);
      allow list: if resource.data.roomId in ['sala-piso-8-dap', 'sala-a-opt', 'sala-b-opt'];

      allow create: if isAdmin()
        && isValidId(meetingId)
        && isValidMeeting(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(meetingId)
        && isValidMeeting(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'roomId',
          'title',
          'organizer',
          'notes',
          'date',
          'startMinutes',
          'endMinutes',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(meetingId);
    }

    // Administrator role records: self-get only, no listing or client-side writes
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }
  }
}
